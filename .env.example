# คัดลอกเป็น .env.local แล้วเติมค่า · secrets จริงอยู่ใน env ของ Vercel/Supabase เท่านั้น (§13.2)
# สร้าง .env.local สำหรับ local อัตโนมัติ: npm run setup:env

# Database (Supabase local: npx supabase status)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# cloud: เนื้อไฟล์ CA จาก Supabase → Database → SSL Configuration (ขึ้นบรรทัดใหม่ใช้ 
 ได้) · local เว้นว่าง
DATABASE_CA_CERT=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session + field encryption (32 bytes base64) + phone hash
SESSION_SECRET=
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_VERSION=1
FIELD_ENCRYPTION_KEY_PREVIOUS=
PHONE_HASH_KEY=

# LINE (เปิดบัญชีใน S0) — LIFF แยกแอปลูกค้า/คนขับ ภายใต้ LINE Login channel เดียวกัน
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID_CUSTOMER=
NEXT_PUBLIC_LIFF_ID_DRIVER=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Background jobs
CRON_SECRET=

# แอป · ภายนอก (ว่างได้ใน local — ใช้ stub)
APP_URL=http://localhost:3000
NEXT_PUBLIC_LINE_OA_URL=
GOOGLE_MAPS_SERVER_KEY=
OMISE_SECRET_KEY=
NEXT_PUBLIC_META_PIXEL_ID=
# DB_POOL_MAX=10
# true = ทุกหน้าแสดงหน้าปิดปรับปรุง, API ตอบ 503 (ยกเว้น /api/health) — docs/go-live.md §7
MAINTENANCE_MODE=

# local เท่านั้น: เข้าสู่ระบบแทน LINE + รหัสผ่านบัญชีแอดมินทดสอบที่ scripts/seed-dev.ts สร้าง
DEV_LOGIN=true
DEV_SEED_PASSWORD=
